{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "dist",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["index.ts", "**/*.ts", "../src/lib/poker/**/*.ts"],
  "exclude": ["dist", "__tests__/**", "../src/lib/poker/__tests__/**"]
}
